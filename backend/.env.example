# Supabase — obrigatórias para autenticação, histórico e proteção do EndoBot
SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_apenas_localmente_a_service_role_key

# CORS do frontend local
FRONTEND_ORIGIN=http://localhost:5173

# IA local — não requer chave de API
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Voz local — OmniVoice TTS + Whisper ASR, sem chave OpenAI
OMNIVOICE_BASE_URL=http://127.0.0.1:7862
OMNIVOICE_TIMEOUT_MS=180000
ENDOBOT_ASR_PROVIDER=local
# Defina OMNIVOICE_DEVICE=cpu ou cuda:0 no ambiente do iniciador de voz, se desejado.
# O padrao auto compartilha GPU com Qwen e pode manter o decodificador na CPU.

# Fallbacks opcionais. Nunca coloque chaves no GitHub.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY_FALLBACK=

# Modelos opcionais
OPENROUTER_MODEL=
NVIDIA_MODEL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
